# ha-react-dashboard — Environment Variables
# Copy this file to .env and fill in your values.

# ━━━━━ REQUIRED ━━━━━
# Home Assistant instance URL (no trailing slash)
# Tested with HA 2026.3.0 and later
VITE_HA_URL=http://homeassistant.local:8123

# Long-lived access token from HA → Profile → Long-Lived Access Tokens
# NOT required if VITE_NO_AUTH=true (running as Add-on)
VITE_HA_TOKEN=

# Dashboard folder name (deployment path: /local/<VITE_FOLDER_NAME>/)
VITE_FOLDER_NAME=ha-dashboard

# ━━━━━ OPTIONAL ━━━━━
# Set to 'true' when running as Home Assistant Add-on
# Disables token requirement and uses local HA connection
VITE_NO_AUTH=false

# ━━━━━ SERVER AUTH ━━━━━
# 'ingress'    = HA add-on derrière le reverse proxy HA
# 'standalone' = token Bearer HA (défaut)
# 'disabled'   = pas d'auth (DEV UNIQUEMENT)
HA_AUTH_MODE=standalone
HA_URL=http://supervisor/core
HA_AUTH=true

# ━━━━━ INTÉGRATION HA (npm run deploy:integration) ━━━━━
# Dossier de configuration de Home Assistant, vu depuis cette machine.
# C'est la voie la plus simple : aucun mot de passe ici, Windows garde celui
# du partage. Nécessite l'add-on « Samba share » côté HA.
#   Windows : \\<ip-de-ton-ha>\config      (monter le partage une fois)
#   Linux   : /mnt/ha-config
# Laisser vide pour utiliser SSH à la place (variables ci-dessous).
HA_CONFIG_PATH=

# ━━━━━ SSH DEPLOYMENT (only for deploy script) ━━━━━
# Hostname/IP of Home Assistant instance for SSH deploy
VITE_SSH_HOSTNAME=192.168.1.100

# SSH username (usually 'root' for HA OS)
VITE_SSH_USERNAME=root

# SSH password
VITE_SSH_PASSWORD=

# Remote deployment path (optional)
# VITE_SSH_DEPLOY_PATH=/config/www/ha-dashboard


# ━━━━━ MODE MOCK (vite --mode mock) ━━━━━
# Chemin d'une maison exportée de Sweet Home 3D avec ExportToHASS, gardée hors
# du dépôt : elle ajoute la page « Maison SH3D ». À mettre dans .env.mock.local.
# VITE_MOCK_SH3D_MODEL=tests/dashboard/fixtures/home.glb

# File d'attente complète de Music Assistant (appli Musique) : adresse du serveur
# MA et jeton créé dans MA (Paramètres > profil > jetons d'accès). Dans l'add-on,
# ce sont les options `music_assistant_url` et `music_assistant_token`.
# MA_URL=http://192.168.1.10:8095
# MA_TOKEN=
