{
  "name": "ha-dashboard",
  "private": true,
  "version": "1.0.8",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "server": "node server/index.js",
    "all": "concurrently -k \"npm run server\" \"npm run dev\"",
    "preview": "vite preview",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,md}\"",
    "type-check": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "sync": "npx tsx scripts/sync-types.ts",
    "prebuild": "npm run prettier",
    "deploy": "npx tsx scripts/deploy.ts",
    "deploy:integration": "npx tsx scripts/deploy-integration.ts",
    "create-tag": "npx tsx scripts/create-tag.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dashboard": "playwright test --config playwright.dashboard.config.ts",
    "test:e2e:dashboard:ui": "playwright test --config playwright.dashboard.config.ts --ui",
    "build:panel": "tsc -b && vite build --mode panel",
    "check:widgets": "tsx scripts/check-widget-registry.ts",
    "new:widget": "tsx scripts/new-widget.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsdom": "^29.1.1",
    "multer": "^2.1.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@hakit/components": "^6.0.2",
    "@hakit/core": "^6.0.2",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-docs": "^10.3.0",
    "@storybook/react": "^10.3.0",
    "@storybook/react-vite": "^10.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/nunjucks": "^3.2.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "hls.js": "^1.6.17",
    "lucide-react": "^0.577.0",
    "node-scp": "^0.0.25",
    "nunjucks": "^3.2.4",
    "prettier": "^3.8.1",
    "prompts": "^2.4.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.0.8",
    "storybook": "^10.3.0",
    "supertest": "^7.2.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.186.0",
    "three-mesh-bvh": "^0.9.15",
    "tsx": "^4.23.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "@fullcalendar/core": "~6.1.20",
    "@fullcalendar/react": "~6.1.20",
    "fullcalendar": "~6.1.20"
  }
}
